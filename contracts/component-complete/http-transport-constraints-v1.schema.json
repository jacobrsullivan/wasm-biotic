{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm-biotic.local/contracts/component-complete/http-transport-constraints-v1.schema.json",
  "title": "Wasm-Biotic bounded HTTP transport constraints v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "origins",
    "methods",
    "request_headers",
    "response_headers",
    "max_url_bytes",
    "max_request_body_bytes",
    "max_response_body_bytes",
    "max_timeout_ms",
    "max_concurrency",
    "redirects",
    "credential_bindings"
  ],
  "properties": {
    "schema": {
      "const": "wasm-biotic.http-transport-constraints.v1"
    },
    "origins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/origin"
      }
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["delete", "get", "head", "patch", "post", "put"]
      }
    },
    "request_headers": {
      "$ref": "#/$defs/request_headers"
    },
    "response_headers": {
      "$ref": "#/$defs/response_headers"
    },
    "max_url_bytes": {
      "$ref": "#/$defs/positive_u64"
    },
    "max_request_body_bytes": {
      "$ref": "#/$defs/positive_u64"
    },
    "max_response_body_bytes": {
      "$ref": "#/$defs/positive_u64"
    },
    "max_timeout_ms": {
      "$ref": "#/$defs/positive_u64"
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "redirects": {
      "const": "deny"
    },
    "credential_bindings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/credential_binding"
      }
    }
  },
  "$defs": {
    "positive_u64": {
      "type": "integer",
      "minimum": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,126}$"
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9:.-]+$"
    },
    "path_prefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^%\\\\?#]*$"
    },
    "cidr": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[0-9a-f:.]+/[0-9]{1,3}$"
    },
    "header_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[!#$%&'*+.^_`|~0-9a-z-]+$"
    },
    "dns_public_only": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "cidrs"],
      "properties": {
        "policy": {
          "const": "public-only"
        },
        "cidrs": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "dns_exact_cidrs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "cidrs"],
      "properties": {
        "policy": {
          "const": "exact-cidrs"
        },
        "cidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/cidr"
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_version", "server_name", "peer_spki_sha256"],
      "properties": {
        "minimum_version": {
          "const": "tls-1.3"
        },
        "server_name": {
          "$ref": "#/$defs/host"
        },
        "peer_spki_sha256": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scheme",
        "host",
        "port",
        "path_prefixes",
        "dns",
        "tls"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contract_id"
        },
        "scheme": {
          "const": "https"
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path_prefix"
          }
        },
        "dns": {
          "oneOf": [
            { "$ref": "#/$defs/dns_public_only" },
            { "$ref": "#/$defs/dns_exact_cidrs" }
          ]
        },
        "tls": {
          "$ref": "#/$defs/tls"
        }
      }
    },
    "request_headers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_names", "max_count", "max_total_bytes"],
      "properties": {
        "allowed_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/header_name"
          }
        },
        "max_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "max_total_bytes": {
          "$ref": "#/$defs/positive_u64"
        }
      }
    },
    "response_headers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposed_names", "max_count", "max_total_bytes"],
      "properties": {
        "exposed_names": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/header_name"
          }
        },
        "max_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "max_total_bytes": {
          "$ref": "#/$defs/positive_u64"
        }
      }
    },
    "credential_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "origin_id",
        "header_name",
        "value_prefix",
        "placement"
      ],
      "properties": {
        "handle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[!-~]+$"
        },
        "origin_id": {
          "$ref": "#/$defs/contract_id"
        },
        "header_name": {
          "$ref": "#/$defs/header_name"
        },
        "value_prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[ -~]+$"
        },
        "placement": {
          "const": "append-to-header-value"
        }
      }
    }
  }
}
