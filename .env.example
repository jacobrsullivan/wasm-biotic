# Provision a rotated credential locally; never commit the populated .env file.
NAPKIN_API_KEY=replace_with_rotated_key

# Optional, operator-supplied credentials for the separate live-provider
# qualification. Deterministic release and acceptance tests do not require them.
OPENAI_API_KEY=replace_with_openai_key
OPENROUTER_API_KEY=replace_with_openrouter_key
